{
  "_comment": "规则集清单。rulesets 的数组顺序即主配置中的匹配顺序（对应 QX 主配置 [filter_remote] 加载顺序）。修改后运行 python tools/build.py。",
  "publish": {
    "base_url": "https://raw.githubusercontent.com/Steeefanie/ClashVerge-rules/main",
    "provider_path_prefix": "./ruleset/clashverge-rules"
  },
  "upstream": {
    "repo": "https://github.com/Steeefanie/QuantumultX-resources",
    "config": "examples/quantumult_steeefanie.conf",
    "extra_files": [
      "LICENSE",
      "examples/quantumult_steeefanie.conf",
      "sources/v2fly/LICENSE"
