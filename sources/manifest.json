  "regions": [
    {
      "name": "Hong Kong",
      "filter": "(?i)^(?!.*(?:流量|到期|剩余|重置|套餐|公告|traffic|expire|reset|quota|balance|(?<![a-z])beta(?![a-z]))).*(?:香港|hong[ _-]?kong|🇭🇰|(?<![a-z])hk(?![a-z])).*$"
    },
    {
      "name": "Taiwan",
      "filter": "(?i)^(?!.*(?:流量|到期|剩余|重置|套餐|公告|traffic|expire|reset|quota|balance|(?<![a-z])beta(?![a-z]))).*(?:台湾|台灣|台北|臺北|台中|新北|高雄|彰化|hinet|cht|taiwan|taipei|🇹🇼|(?<![a-z])tw(?![a-z])).*$"
    },
    {
      "name": "Japan",
      "filter": "(?i)^(?!.*(?:流量|到期|剩余|重置|套餐|公告|traffic|expire|reset|quota|balance|(?<![a-z])beta(?![a-z]))).*(?:日本|东京|東京|大阪|japan|tokyo|osaka|🇯🇵|(?<![a-z])jp(?![a-z])).*$"
    },
    {
      "name": "Singapore",
      "filter": "(?i)^(?!.*(?:流量|到期|剩余|重置|套餐|公告|traffic|expire|reset|quota|balance|(?<![a-z])beta(?![a-z]))).*(?:新加坡|狮城|獅城|singapore|🇸🇬|(?<![a-z])sg(?![a-z])).*$"
    },
    {
      "name": "United States",
      "filter": "(?i)^(?!.*(?:流量|到期|剩余|重置|套餐|公告|traffic|expire|reset|quota|balance|(?<![a-z])beta(?![a-z]))).*(?:美国|美國|洛杉矶|洛杉磯|圣何塞|聖荷西|西雅图|西雅圖|纽约|紐約|united[ _-]?states|american?|los[ _-]?angeles|san[ _-]?jose|seattle|new[ _-]?york|🇺🇸|(?<![a-z])us(?![a-z])).*$"
    }
  ],
